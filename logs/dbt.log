[0m22:40:39.136501 [debug] [Thread-1 (]: On model.dbt_examples.dim_customers: /* {"app": "dbt", "dbt_version": "1.11.4", "profile_name": "dbt_examples", "target_name": "dev", "node_id": "model.dbt_examples.dim_customers"} */

  
    

    create or replace table `project-7ee4da2e-e172-46d6-870`.`jaffle_shop`.`dim_customers`
      
    
    

    
    OPTIONS()
    as (
      with customers as (

    select
        id as customer_id,
        first_name,
        last_name

    from `project-7ee4da2e-e172-46d6-870`.`jaffle_shop`.`stg_customers`

),

 orders as (

    select
        id as order_id,
        user_id as customer_id,
        order_date,
        status
    from `project-7ee4da2e-e172-46d6-870`.`jaffle_shop`.`stg_orders`

),

customer_orders as (

    select
        customer_id,

        min(order_date) as first_order_date,
        max(order_date) as most_recent_order_date,
        count(order_id) as number_of_orders

    from orders

    group by 1

),

final as (

    select
        customers.customer_id,
        customers.first_name,
        customers.last_name,
        customer_orders.first_order_date,
        customer_orders.most_recent_order_date,
        coalesce(customer_orders.number_of_orders, 0) as number_of_orders

    from customers

    left join customer_orders using (customer_id)

)

select * from final
    );
  
